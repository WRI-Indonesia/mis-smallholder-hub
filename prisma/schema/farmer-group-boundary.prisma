// farmer-group-boundary.prisma — ICS/lembaga boundary polygons (issue #266)

model FarmerGroupBoundary {
  id            String      @id @default(cuid())
  farmerGroupId String      @map("farmer_group_id")
  farmerGroup   FarmerGroup @relation(fields: [farmerGroupId], references: [id])
  // Dual-column: `geom` (PostGIS, SRID 4326) adalah sumber kebenaran untuk
  // analisa spasial (ST_Intersects/ST_Contains, GiST index di migration);
  // `geojson` adalah cache GeoJSON untuk rendering peta (pola LandParcel).
  // Kolom Unsupported tidak terbaca Prisma Client — tulis via $executeRaw
  // ST_GeomFromGeoJSON (lihat scripts/local/seed/seed-boundary-lembaga.ts).
  geom          Unsupported("geometry(MultiPolygon, 4326)")?
  geojson       Json        @map("geojson") // GeoJSON MultiPolygon WGS84
  source        String?     @map("source") // nama file shapefile asal
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  createdBy     String?     @map("created_by")
  modifiedAt    DateTime    @updatedAt @map("modified_at")
  modifiedBy    String?     @map("modified_by")

  @@index([farmerGroupId])
  @@index([isActive])
  @@map("tbl_farmer_group_boundary")
}
