// land-parcel-program.prisma — keikutsertaan lahan dalam program (demplot PBU,
// dst.). Satelit 1:N dari LandParcelIdentity (Decision Log 2026-08-27).
// Level LAHAN dulu (keputusan owner): entitas Program/PBU sendiri (periode,
// pendamping, anggaran) belum dimodelkan — bila dibutuhkan, tambahkan
// tbl_program dan FK programId di sini tanpa mengubah baris yang ada.
// Catatan: isPsr di LandParcel secara konsep juga "program", dibiarkan (sudah
// dipakai luas di dashboard/produksi).

enum LandProgramType {
  DEMPLOT_PBU // lahan percontohan Productive Business Unit
}

enum LandProgramStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model LandParcelProgram {
  id          String             @id @default(cuid())
  parcelUid   String             @map("parcel_uid")
  parcel      LandParcelIdentity @relation(fields: [parcelUid], references: [id])
  programType LandProgramType    @map("program_type")
  status      LandProgramStatus  @default(ACTIVE) @map("status")
  startDate   DateTime?          @map("start_date")
  endDate     DateTime?          @map("end_date")
  notes       String?            @map("notes")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  createdBy   String?            @map("created_by")
  modifiedAt  DateTime           @updatedAt @map("modified_at")
  modifiedBy  String?            @map("modified_by")

  @@index([parcelUid, isActive])
  @@index([programType, status])
  @@map("tbl_land_parcel_program")
}
