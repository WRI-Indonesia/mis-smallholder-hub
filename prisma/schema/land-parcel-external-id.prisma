// land-parcel-external-id.prisma — identitas lahan dari sistem/vendor luar
// (Decision Log 2026-08-27). Sumber awal: kolom "parcel_code" di
// MIS_<KAB>_data-lahan.xlsx (mis. "ID080d781b4", prefix ID/WR) — kode hasil
// pemetaan pihak ketiga, tidak berkaitan dengan parcelId internal. Satu tabel
// untuk semua penerbit (kode e-STDB, RSPO, Dinas menyusul) lewat kolom source.

model LandParcelExternalId {
  id          String             @id @default(cuid())
  parcelUid   String             @map("parcel_uid")
  parcel      LandParcelIdentity @relation(fields: [parcelUid], references: [id])
  source      String             @map("source") // penerbit kode, mis. "VENDOR_MAPPING_2025"
  code        String             @map("code")
  // Poligon mentah dari vendor (GeoJSON) — OPSIONAL, keputusan owner
  // 2026-08-27. Diisi bila tersedia agar jejak asal poligon LandParcel tak
  // hilang; tidak dipakai untuk rendering/analisis (itu tugas LandParcel.geometry).
  rawGeometry Json?              @map("raw_geometry")
  mappedAt    DateTime?          @map("mapped_at")
  notes       String?            @map("notes")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  createdBy   String?            @map("created_by")
  modifiedAt  DateTime           @updatedAt @map("modified_at")
  modifiedBy  String?            @map("modified_by")

  // Unik per penerbit, bukan per lahan (satu lahan boleh punya kode dari
  // beberapa penerbit).
  @@unique([source, code])
  @@index([parcelUid, isActive])
  @@map("tbl_land_parcel_external_id")
}
