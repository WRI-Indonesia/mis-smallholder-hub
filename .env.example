# =====================================================================
# Skema env file (lihat docs/standards/environments.md):
#   .env          → LOCAL, satu-satunya yang dibaca otomatis (default)
#   .env.dev      → DB dev     + S3 dev
#   .env.staging  → DB staging + S3 dev (staging tidak punya bucket sendiri)
#   .env.prod     → DB prod    + S3 prod (hanya via `npx dotenv -e .env.prod --`)
# Semua file .env* di-gitignore kecuali file contoh ini.
# =====================================================================

# --- GENERAL ---
# NASA FIRMS active-fire proxy (/api/map-hotspot) — free MAP_KEY dari firms.modaps.eosdis.nasa.gov
FIRMS_MAP_KEY_FREE=""
NEXTAUTH_URL="http://localhost:3000"
# Password akun contoh saat `prisma db seed` (min. 12 karakter; jangan di-commit) — #390
SEED_USER_PASSWORD=
NEXTAUTH_SECRET="super-secret-key"
S3_ENDPOINT="https://is3.cloudhost.id"
S3_REGION="id-jkt-1"

# --- DATABASE ---
DATABASE_URL="postgresql://user:password@localhost:5432/smallholder_hub"

# --- S3 (S3-compatible — is3.cloudhost.id) ---
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="mis-dev"

# --- OPSIONAL (ada fallback bawaan; biarkan terkomentar) ---
# Folder tabel CSV prototipe Rantai Pasok (bawaan: scripts/local/seed/data-supply-chain/tables)
# SUPPLY_CHAIN_TABLES_DIR=
# Folder data skrip seed batas administrasi / boundary Lembaga (bawaan: scripts/local/seed/…)
# SEED_DATA_DIR=
